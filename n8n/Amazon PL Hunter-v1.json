      "id": "89c5ba47-680e-4e36-8035-ab43f5ebcb64",
      "name": "WhatsApp Webhook",
      "webhookId": "d2c2d756-8326-41cb-a705-ab9bd9c9c63b"
    },
    {
      "parameters": {
        "jsCode": "const VERIFY_TOKEN = 'plhunter26';\n\n// Get query params from incoming webhook\nconst query = $input.first().json.query;\n\nconst mode      = query['hub.mode'];\nconst token     = query['hub.verify_token'];\nconst challenge = query['hub.challenge'];\n\n// Verification request from Meta (GET)\nif (mode === 'subscribe' && token === VERIFY_TOKEN) {\n  return [{ json: { statusCode: 200, body: challenge } }];\n} else {\n  return [{ json: { statusCode: 403, body: 'Forbidden' } }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        176,
        264
      ],
      "id": "7a92a964-83c7-407e-9113-6b798d3d9b4d",
      "name": "Subscribe Webhook",
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.body }}",
        "options": {
          "responseCode": "={{ $json.statusCode }}"
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        400,
        264
      ],
      "id": "589ce528-78df-4862-b225-60aa76742a12",
      "name": "Respond to Subscribe"
    },
    {
      "parameters": {
        "jsCode": "const json = $input.first().json;\n\n// Extract the actual WhatsApp message\nconst entry = json?.body?.entry?.[0];\nconst change = entry?.changes?.[0];\nconst message = change?.value?.messages?.[0];\n\nif (!message) {\n  return [{ json: { skip: true } }];\n}\n\nconst text = message.text?.body?.trim() || '';\n\nreturn [{\n  json: {\n    from: message.from,\n    messageId: message.id,\n    text,\n    timestamp: message.timestamp,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        456
      ],
      "id": "d5544a09-859c-40b1-a1a2-2c228e1935c9",
      "name": "Extract Message"
    },
    {
      "parameters": {
        "jsCode": "const msg = $('Extract Message').first().json.text.toLowerCase();\n\nlet command = \"chat\";\nlet payload = \"\";\nlet refresh = false;\n\nif (msg === \"help\") {\n  command = \"help\";\n} else if (/^refresh asin /i.test(msg)) {\n  command = \"asin\";\n  payload = msg.split(\" \")[2].toUpperCase();\n  refresh = true;\n} else if (/^refresh hunt /i.test(msg)) {\n  command = \"hunt\";\n  payload = msg.replace(/^refresh hunt /i, \"\").trim();\n  refresh = true;\n} else if (/^asin /i.test(msg)) {\n  command = \"asin\";\n  payload = msg.split(\" \")[1].toUpperCase();\n} else if (/^hunt /i.test(msg)) {\n  command = \"hunt\";\n  payload = msg.replace(/^hunt /i, \"\").trim();\n} else if (/^clear all$/i.test(msg)) {\n  command = \"clear_all\";\n} else if (/^clear asin /i.test(msg)) {\n  command = \"clear_asin\";\n  payload = msg.split(\" \")[2].toUpperCase();\n} else if (/^clear hunt /i.test(msg)) {\n  command = \"clear_hunt\";\n  payload = msg.replace(/^clear hunt /i, \"\").trim();\n}\n\nreturn [{\n  json: {\n    ...$input.first().json,\n    command,\n    payload,\n    refresh,\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
